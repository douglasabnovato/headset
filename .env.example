# Copie para server/.env (opcional em desenvolvimento; a API lê esse arquivo sozinha).
PORT=3333
# Obrigatório em produção: gere com `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
# Caminho do SQLite (vazio = server/data/headset.db)
DATABASE_URL=
NODE_ENV=development
# 1 = demonstração pública: desliga o upload de imagens no admin
DEMO=

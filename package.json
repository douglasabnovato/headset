{
  "name": "headset",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Headset Store · e-commerce de headphones fullstack em TypeScript (React + Vite / Express + Drizzle + SQLite)",
  "workspaces": ["server"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w server\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "npm run dev -w server",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run build && concurrently -n api,web \"npm start -w server\" \"vite preview\"",
    "db:seed": "npm run db:seed -w server",
    "test": "vitest run && npm test -w server",
    "typecheck": "tsc -b && npm run typecheck -w server"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "cep-promise": "^4.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "less": "^4.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
